# hCaptcha's test sitekey (always passes), so `npm run dev` shows a working widget on localhost, which the real key refuses.
VITE_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
# Dev reads the API Worker through Vite's proxy to localhost:8787, so it is same-origin and needs no CORS.
VITE_API_URL=/api
