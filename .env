# Site settings for every mode; public by design (read by the browser).
# The Turnstile widget's sitekey for kiostz.github.io: a placeholder until the owner creates the widget in Cloudflare and pastes its sitekey here.
VITE_TURNSTILE_SITEKEY=REPLACE_WITH_TURNSTILE_SITEKEY
# The API Worker the shop reads its items, clubs and settings from and sends orders to (no trailing slash).
VITE_API_URL=https://pem-pathfinder-store-api.pempathfinder.workers.dev
