// API Worker config: name, D1 binding and the one allowed browser origin.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Worker name; the public address is pem-pathfinder-store-api.<account>.workers.dev.
  "name": "pem-pathfinder-store-api",
  // The Cloudflare account that holds the Worker and D1; an id, not a secret.
  "account_id": "ba2ef6d4564416a1b85b1c868def978a",
  // Entry file of the Worker.
  "main": "src/index.ts",
  // Date of the installed workerd, so runtime behaviour is pinned.
  "compatibility_date": "2026-10-12",
  // Serve on the workers.dev subdomain.
  "workers_dev": true,
  // Turn Workers Logs on (never log buyer data).
  "observability": { "enabled": true },
  // SHOP_ORIGIN: the only origin that gets a CORS header and may POST orders. ORDER_EMAIL_FROM: the order email's sender (Email Routing on stardew.win). ADMIN_URL: the link on the order email's last line.
  "vars": {
    "SHOP_ORIGIN": "https://kiostz.github.io",
    "ORDER_EMAIL_FROM": "orders@stardew.win",
    "ADMIN_URL": "https://pem-pathfinder-store-admin.pempathfinder.workers.dev",
  },
  // Sends the order email; the club inbox is the secret ORDER_EMAIL_TO, so the binding is not limited to one address. Local runs write the email to a file.
  "send_email": [{ "name": "ORDER_EMAIL" }],
  // Per-IP limit on public reads: 60 requests per 60 seconds, answered 429 past it.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "d1_databases": [
    {
      // Name of the binding in code: env.DB.
      "binding": "DB",
      "database_name": "pem-pathfinder-store",
      // The D1 database created on Cloudflare 2026-11-01 (APAC); not a secret.
      "database_id": "8f152bd0-fd5b-4b1e-93c4-0eb4098c4b19",
      // Shared migrations folder, owned by this Worker's config.
      "migrations_dir": "../migrations",
    },
  ],
}
