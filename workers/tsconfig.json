// TypeScript config for the Worker source: Workers runtime types, strict, no emit.
{
  "compilerOptions": {
    // Modern syntax matching the workerd runtime.
    "target": "es2023",
    // ES2023 stdlib only; Workers types come from worker-configuration.d.ts.
    "lib": ["ES2023"],
    // Bundler-style resolution, as wrangler bundles the code.
    "module": "esnext",
    "moduleResolution": "bundler",
    // No ambient packages; runtime types are generated by `wrangler types`.
    "types": [],
    // Skip third-party declaration checks.
    "skipLibCheck": true,
    // Every file is a module.
    "moduleDetection": "force",
    // Type-check only.
    "noEmit": true,
    // All strict flags.
    "strict": true,
    // Unused locals and parameters are errors.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Switch cases may not fall through.
    "noFallthroughCasesInSwitch": true
  },
  // Source, the generated runtime types and the Vitest config.
  "include": ["api/src", "api/worker-configuration.d.ts", "vitest.config.ts"]
}
