# Dev only: `npm run dev -- --mode fake-send` logs the order instead of sending it, and uses hCaptcha's always-passing test key so the widget works on localhost.
VITE_ORDER_SEND=fake
VITE_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
# Dev reads the API Worker through Vite's proxy to localhost:8787, so it is same-origin and needs no CORS.
VITE_API_URL=/api
